	doi = {10.1103/PhysRevLett.118.170401},
	abstract = {We experimentally study the emergence of antiferromagnetic correlations between ultracold fermionic atoms in a two-dimensional optical lattice with decreasing temperature. We determine the uniform magnetic susceptibility of the two-dimensional Hubbard model from simultaneous measurements of the in situ density distribution of both spin components. At half filling and strong interactions our data approach the Heisenberg model of localized spins with antiferromagnetic correlations. Moreover, we observe a fast decay of magnetic correlations when doping the system away from half filling.},
