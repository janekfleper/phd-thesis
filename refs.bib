@article{goldman_periodically_2014,
	title = {Periodically Driven Quantum Systems: Effective Hamiltonians and Engineered Gauge Fields},
	volume = {4},
	url = {https://link.aps.org/doi/10.1103/PhysRevX.4.031027},
	doi = {10.1103/PhysRevX.4.031027},
	shorttitle = {Periodically Driven Quantum Systems},
	abstract = {Driving a quantum system periodically in time can profoundly alter its long-time dynamics and trigger topological order. Such schemes are particularly promising for generating nontrivial energy bands and gauge structures in quantum-matter systems. Here, we develop a general formalism that captures the essential features ruling the dynamics: the effective Hamiltonian, but also the effects related to the initial phase of the modulation and the micromotion. This framework allows for the identification of driving schemes, based on general N-step modulations, which lead to configurations relevant for quantum simulation. In particular, we explore methods to generate synthetic spin-orbit couplings and magnetic fields in cold-atom setups.},
	pages = {031027},
	number = {3},
	journaltitle = {Physical Review X},
	shortjournal = {Phys. Rev. X},
	author = {Goldman, N. and Dalibard, J.},
	urldate = {2020-01-30},
	date = {2014-08-18},
	keywords = {floquet driving, mthesis, theory, refs},
	file = {APS Snapshot:/home/janek/Zotero/storage/AC68Z2XP/PhysRevX.4.html:text/html;Full Text PDF:/home/janek/Zotero/storage/PELHZB7S/Goldman and Dalibard - 2014 - Periodically Driven Quantum Systems Effective Ham.pdf:application/pdf},
}

@article{chin_feshbach_2010,
	title = {Feshbach resonances in ultracold gases},
	volume = {82},
	url = {https://link.aps.org/doi/10.1103/RevModPhys.82.1225},
	doi = {10.1103/RevModPhys.82.1225},
	abstract = {Feshbach resonances are the essential tool to control the interaction between atoms in ultracold quantum gases. They have found numerous experimental applications, opening up the way to important breakthroughs. This review broadly covers the phenomenon of Feshbach resonances in ultracold gases and their main applications. This includes the theoretical background and models for the description of Feshbach resonances, the experimental methods to find and characterize the resonances, a discussion of the main properties of resonances in various atomic species and mixed atomic species systems, and an overview of key experiments with atomic Bose-Einstein condensates, degenerate Fermi gases, and ultracold molecules.},
	pages = {1225--1286},
	number = {2},
	journaltitle = {Reviews of Modern Physics},
	shortjournal = {Rev. Mod. Phys.},
	author = {Chin, Cheng and Grimm, Rudolf and Julienne, Paul and Tiesinga, Eite},
	urldate = {2019-01-30},
	date = {2010-04-29},
	keywords = {feshbach, refs, review, ultracold quantum gases},
	file = {APS Snapshot:/home/janek/Zotero/storage/XG47Z6U8/RevModPhys.82.html:text/html;Full Text PDF:/home/janek/Zotero/storage/P9VECDJH/Chin et al. - 2010 - Feshbach resonances in ultracold gases.pdf:application/pdf},
