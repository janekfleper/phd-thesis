@article{ovchinnikov_diffraction_1999,
	title = {Diffraction of a Released Bose-Einstein Condensate by a Pulsed Standing Light Wave},
	volume = {83},
	url = {https://link.aps.org/doi/10.1103/PhysRevLett.83.284},
	doi = {10.1103/PhysRevLett.83.284},
	abstract = {We study the diffraction of a released sodium Bose-Einstein condensate by a pulsed standing light wave. The width of the momentum distribution of the diffracted atoms exhibits strong oscillations as a function of the pulse duration, corresponding to periodic focusing and collimation of the condensate inside the standing light wave. Applications of this thick grating regime of diffraction to atom interferometry are discussed.},
