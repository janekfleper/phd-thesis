@article{nakajima_topological_2016,
	title = {Topological Thouless Pumping of Ultracold Fermions},
	volume = {12},
	issn = {1745-2473, 1745-2481},
	url = {http://arxiv.org/abs/1507.02223},
	doi = {10.1038/nphys3622},
	abstract = {A gas of electrons in a one-dimensional periodic potential can be transported even in the absence of a voltage bias if the potential is modulated slowly and periodically in time. Remarkably, the transferred charge per cycle is only sensitive to the topology of the path in parameter space. Although this so-called Thouless charge pump has first been proposed more than thirty years ago, it has not yet been realized. Here we report the first demonstration of topological Thouless pumping using ultracold atoms in a dynamically controlled optical superlattice. We observe a shift of the atomic cloud as a result of pumping and extract the topological invariance of the pumping process from this shift. We demonstrate the topological nature of the Thouless pump by varying the topology of the pumping path and verify that the topological pump indeed works in the quantum region by varying speed and temperature.},
	pages = {296--300},
	number = {4},
	journaltitle = {Nature Physics},
	shortjournal = {Nature Phys},
	author = {Nakajima, Shuta and Tomita, Takafumi and Taie, Shintaro and Ichinose, Tomohiro and Ozawa, Hideki and Wang, Lei and Troyer, Matthias and Takahashi, Yoshiro},
	urldate = {2021-02-25},
	date = {2016-04},
	eprinttype = {arxiv},
	eprint = {1507.02223},
	keywords = {superlattice, phd, bose hubbard, yb171, refs, topo},
	file = {arXiv.org Snapshot:/home/janek/Zotero/storage/ATQYYJXI/1507.html:text/html;Nakajima et al_2016_Topological Thouless pumping of ultracold fermions.pdf:/home/janek/Zotero/storage/J7MWEYDS/Nakajima et al_2016_Topological Thouless pumping of ultracold fermions.pdf:application/pdf;Nakajima et al_2016_Topological Thouless Pumping of Ultracold Fermions.pdf:/home/janek/Zotero/storage/EH3DH3JN/Nakajima et al_2016_Topological Thouless Pumping of Ultracold Fermions.pdf:application/pdf;Snapshot:/home/janek/Zotero/storage/8EKM7WKX/nphys3622.html:text/html},
