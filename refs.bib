	note = {Publisher: American Physical Society},
	keywords = {cs133, superlattice, eta pairs, refs},
	file = {APS Snapshot:/home/janek/Zotero/storage/QK7BRTBF/PhysRevLett.133.html:text/html;Full Text PDF:/home/janek/Zotero/storage/WUAX2JSL/Impertro et al. - 2024 - Local Readout and Control of Current and Kinetic Energy Operators in Optical Lattices.pdf:application/pdf;Supplementary-Material.pdf:/home/janek/Zotero/storage/2NPPI6CP/Supplementary-Material.pdf:application/pdf},
}

