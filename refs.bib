@article{ville_loading_2017,
	title = {Loading and compression of a single two-dimensional Bose gas in an optical accordion},
	volume = {95},
	url = {https://link.aps.org/doi/10.1103/PhysRevA.95.013632},
	doi = {10.1103/PhysRevA.95.013632},
	abstract = {The experimental realization of two-dimensional (2D) Bose gases with a tunable interaction strength is an important challenge for the study of ultracold quantum matter. Here we report on the realization of an optical accordion creating a lattice potential with a spacing that can be dynamically tuned between 11 and 2 μm. We show that we can load ultracold 87Rb atoms into a single node of this optical lattice in the large spacing configuration and then decrease nearly adiabatically the spacing to reach a strong harmonic confinement with frequencies larger than ωz/2π=10 {kHz}. Atoms are trapped in an additional flat-bottom in-plane potential that is shaped with a high resolution. By combining these tools we create custom-shaped uniform 2D Bose gases with tunable confinement along the transverse direction and hence with a tunable interaction strength.},
	pages = {013632},
	number = {1},
	journaltitle = {Physical Review A},
	shortjournal = {Phys. Rev. A},
	author = {Ville, J. L. and Bienaimé, T. and Saint-Jalm, R. and Corman, L. and Aidelsburger, M. and Chomaz, L. and Kleinlein, K. and Perconte, D. and Nascimbène, S. and Dalibard, J. and Beugnon, J.},
	urldate = {2019-01-25},
	date = {2017-01-27},
	keywords = {bec, osaka, rb87, refs, ultracold quantum gases},
	file = {APS Snapshot:/home/janek/Zotero/storage/U5VKHCJE/PhysRevA.95.html:text/html;Full Text PDF:/home/janek/Zotero/storage/UKUD9AS5/Ville et al. - 2017 - Loading and compression of a single two-dimensiona.pdf:application/pdf},
}

