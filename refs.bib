	doi = {10.1103/PhysRevLett.74.1542},
	abstract = {We localize Cs atoms in wavelength-sized potential wells of an optical lattice, and cool them to a three-dimensional temperature of 700 {nK} by adiabatic expansion. In the optical lattice we precool the atoms to ≈1⁢𝜇⁢K. We then reduce the trapping potential in a few hundred 𝜇s, causing the atomic center-of-mass distribution to expand and the temperature to decrease by an amount which agrees with a simple 3D band theory. These are the lowest 3D kinetic temperatures ever measured.},
