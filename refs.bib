	file = {Full Text PDF:/home/janek/Zotero/storage/2WQ9HD8S/Xygkis et al. - 2023 - Absorption coefficients and scattering losses of TGG, TGP, KTF, FS, and CeF₃ magneto-optic crystals.pdf:application/pdf},
}

