	keywords = {floquet driving, theory, refs},
	file = {Submitted Version:/home/janek/Zotero/storage/3RGW3CKS/Bukov et al. - 2015 - Universal high-frequency behavior of periodically driven systems from dynamical stabilization to Fl.pdf:application/pdf},
}

