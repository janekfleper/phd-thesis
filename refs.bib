@article{li_high-powered_2021,
	title = {High-powered optical superlattice with robust phase stability for quantum gas microscopy},
	volume = {29},
	rights = {\&\#169; 2021 Optical Society of America},
	issn = {1094-4087},
	url = {https://www.osapublishing.org/oe/abstract.cfm?uri=oe-29-9-13876},
	doi = {10.1364/OE.423776},
	abstract = {Optical superlattice has a wide range of applications in the study of ultracold atom physics. Especially, it can be used to trap and manipulate thousands of atom pairs in parallel which constitutes a promising system for quantum simulation and quantum computation. In the present work, we report on a high-power optical superlattice formed by a 532-nm and 1064-nm dual-wavelength interferometer with a short lattice spacing of 630 nm. The short-term fluctuation (in 10 seconds) of the relative phase between the short lattice and the long lattice is measured to be 0.003\&\#x03C0;, which satisfies the needs for performing two-qubit gates among neighboring lattice sites. We further implement this superlattice in a 87Rb experiment with a quantum gas microscope of single-site resolution, where the high-power 532-nm laser is necessary for pinning atoms in the short lattice during imaging, providing a unique platform for engineering quantum states.},
	pages = {13876--13886},
	number = {9},
	journaltitle = {Optics Express},
	shortjournal = {Opt. Express, {OE}},
	author = {Li, Meng-Da and Lin, Wan and Luo, An and Zhang, Wei-Yong and Sun, Hui and Xiao, Bo and Zheng, Yong-Guang and Yuan, Zhen-Sheng and Pan, Jian-Wei},
	urldate = {2021-05-20},
	date = {2021-04-21},
	note = {Publisher: Optical Society of America},
	keywords = {rb87, superlattice, refs},
	file = {Li et al. - 2021 - High-powered optical superlattice with robust phas.pdf:/home/janek/Zotero/storage/AU33RD34/Li et al. - 2021 - High-powered optical superlattice with robust phas.pdf:application/pdf;Snapshot:/home/janek/Zotero/storage/8EEHLGKB/fulltext.html:text/html},
