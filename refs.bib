@article{kohl_fermionic_2005,
	title = {Fermionic Atoms in a Three Dimensional Optical Lattice: Observing Fermi Surfaces, Dynamics, and Interactions},
	volume = {94},
	url = {https://link.aps.org/doi/10.1103/PhysRevLett.94.080403},
	doi = {10.1103/PhysRevLett.94.080403},
	shorttitle = {Fermionic Atoms in a Three Dimensional Optical Lattice},
	abstract = {We have studied interacting and noninteracting quantum degenerate Fermi gases in a three-dimensional optical lattice. We directly image the Fermi surface of the atoms in the lattice by turning off the optical lattice adiabatically. Because of the confining potential, gradual filling of the lattice transforms the system from a normal state into a band insulator. The dynamics of the transition from a band insulator to a normal state is studied, and the time scale is measured to be an order of magnitude larger than the tunneling time in the lattice. Using a Feshbach resonance, we increase the interaction between atoms in two different spin states and dynamically induce a coupling between the lowest energy bands. We observe a shift of this coupling with respect to the Feshbach resonance in free space which is anticipated for strongly confined atoms.},
	pages = {080403},
	number = {8},
	journaltitle = {Physical Review Letters},
	shortjournal = {Phys. Rev. Lett.},
	author = {Köhl, Michael and Moritz, Henning and Stöferle, Thilo and Günter, Kenneth and Esslinger, Tilman},
	urldate = {2020-12-13},
	date = {2005-03-04},
	note = {Publisher: American Physical Society},
	keywords = {fermi hubbard, k40, rb87, mrefs, refs},
	file = {APS Snapshot:/home/janek/Zotero/storage/GRP5WVQX/PhysRevLett.94.html:text/html;Köhl et al_2005_Fermionic Atoms in a Three Dimensional Optical Lattice.pdf:/home/janek/Zotero/storage/S5KVVQJU/Köhl et al_2005_Fermionic Atoms in a Three Dimensional Optical Lattice.pdf:application/pdf},
