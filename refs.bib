@article{zhou_exploring_2023,
	title = {Exploring interacting topological insulator in the extended Su-Schrieffer-Heeger model},
	volume = {107},
	url = {https://link.aps.org/doi/10.1103/PhysRevB.107.054105},
	doi = {10.1103/PhysRevB.107.054105},
	abstract = {Exploring topological phases in interacting systems is a challenging task. We investigate many-body topological physics of interacting fermions in an extended Su-Schrieffer-Heeger ({SSH}) model, which extends the two sublattices of the {SSH} model into four sublattices and thus is dubbed the {SSH}4 model, based on the density-matrix renormalization-group numerical method. The interaction-driven phase transition from the topological insulator phase to the charge density wave ({CDW}) phase can be identified by analyzing the variations of the entanglement spectrum, entanglement entropies, energy gaps, {CDW} order parameter, and fidelity. We map the global phase diagram of the many-body ground state, which contains nontrivial topological insulator, trivial insulator, and {CDW} phases, respectively. In contrast to the interacting {SSH} model, in which the phase transitions to the {CDW} phase are argued to be first-order phase transitions, the phase transitions between the {CDW} phase and topologically trivial or nontrivial phases are shown to be continuous phase transitions. Finally, we also show the phase diagram of the interacting spinful {SSH}4 model, where the attractive (repulsive) on-site spin interaction amplifies (suppresses) the {CDW} phase. The models analyzed here can be implemented with ultracold atoms on optical superlattices.},
	pages = {054105},
	number = {5},
	journaltitle = {Physical Review B},
	shortjournal = {Phys. Rev. B},
	author = {Zhou, Xiaofan and Pan, Jian-Song and Jia, Suotang},
	urldate = {2024-12-28},
	date = {2023-02-14},
	note = {Publisher: American Physical Society},
	keywords = {theory, superlattice, refs},
	file = {APS Snapshot:/home/janek/Zotero/storage/2KDW3TI4/PhysRevB.107.html:text/html;Full Text PDF:/home/janek/Zotero/storage/TIG3PM8L/Zhou et al. - 2023 - Exploring interacting topological insulator in the extended Su-Schrieffer-Heeger model.pdf:application/pdf},
}

