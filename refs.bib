@article{esslinger_fermi-hubbard_2010,
	title = {Fermi-Hubbard Physics with Atoms in an Optical Lattice},
	url = {https://www.annualreviews.org/doi/abs/10.1146/annurev-conmatphys-070909-104059},
	doi = {10.1146/annurev-conmatphys-070909-104059},
	abstract = {The Fermi-Hubbard model is a key concept in condensed matter physics and provides crucial insights into electronic and magnetic properties of materials. Yet, the intricate nature of Fermi systems poses a barrier to answering important questions concerning d-wave superconductivity and quantum magnetism. Recently, it has become possible to experimentally realize the Fermi-Hubbard model using a fermionic quantum gas loaded into an optical lattice. In this atomic approach to the Fermi-Hubbard model, the Hamiltonian is a direct result of the optical lattice potential created by interfering laser fields and short-ranged ultracold collisions. It provides a route to simulate the physics of the Hamiltonian and to address open questions and novel challenges of the underlying many-body system. This review gives an overview of the current efforts in understanding and realizing experiments with fermionic atoms in optical lattices and discusses key experiments in the metallic, band-insulating, superfluid, and Mott-insulating regimes.},
	journaltitle = {http://dx.doi.org/10.1146/annurev-conmatphys-070909-104059},
	author = {Esslinger, Tilman},
	urldate = {2020-12-05},
	date = {2010-07-29},
	langid = {english},
	note = {Publisher: Annual Reviews},
	keywords = {fermi hubbard, review, mrefs, refs},
	file = {Esslinger_2010_Fermi-Hubbard Physics with Atoms in an Optical Lattice.pdf:/home/janek/Zotero/storage/JSCSMX42/Esslinger_2010_Fermi-Hubbard Physics with Atoms in an Optical Lattice.pdf:application/pdf;Snapshot:/home/janek/Zotero/storage/6PV8QXTL/annurev-conmatphys-070909-104059.html:text/html},
}

@article{kohl_fermionic_2005,
	title = {Fermionic Atoms in a Three Dimensional Optical Lattice: Observing Fermi Surfaces, Dynamics, and Interactions},
	volume = {94},
	url = {https://link.aps.org/doi/10.1103/PhysRevLett.94.080403},
	doi = {10.1103/PhysRevLett.94.080403},
	shorttitle = {Fermionic Atoms in a Three Dimensional Optical Lattice},
	abstract = {We have studied interacting and noninteracting quantum degenerate Fermi gases in a three-dimensional optical lattice. We directly image the Fermi surface of the atoms in the lattice by turning off the optical lattice adiabatically. Because of the confining potential, gradual filling of the lattice transforms the system from a normal state into a band insulator. The dynamics of the transition from a band insulator to a normal state is studied, and the time scale is measured to be an order of magnitude larger than the tunneling time in the lattice. Using a Feshbach resonance, we increase the interaction between atoms in two different spin states and dynamically induce a coupling between the lowest energy bands. We observe a shift of this coupling with respect to the Feshbach resonance in free space which is anticipated for strongly confined atoms.},
	pages = {080403},
	number = {8},
	journaltitle = {Physical Review Letters},
	shortjournal = {Phys. Rev. Lett.},
	author = {Köhl, Michael and Moritz, Henning and Stöferle, Thilo and Günter, Kenneth and Esslinger, Tilman},
	urldate = {2020-12-13},
