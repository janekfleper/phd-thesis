#let colorbar-10(lim: (0.0, 1.5)) = {
  let scale = 1 / (lim.at(1) - lim.at(0)) * 100%
  let shift = 50% - (lim.at(0) + lim.at(1)) / 2 * scale

  let transform(point) = {
    let (x, y) = point
    return (0, 100% - (y * scale + shift))
  }


  let label-colormap = (
    position: (100% + 3.3em, 50.0%),
    body: rotate(
      -90.0deg,
      place(
        center + top,
        box(
          width: 4cm,
          text(
            size: 1em,
            fill: black,
            [Atomic density $n(x, y) slash #unit[μm^2]$],
          ),
        ),
      ),
    ),
  )
  let colormap-major-ticks = (
    locs: (0.0, 0.25, 0.5, 0.75, 1.0, 1.25, 1.5),
    labels: ($0$, $0.25$, $0.5$, $0.75$, $1$, $1.25$, $1.5$),
    tick-style: yaxis-major-tick-style,
    label-style: yaxis-major-label-style,
  )
  let colormap-minor-ticks = (
    locs: range(6).map(c => c / 4 + 0.125),
    labels: (),
    tick-style: yaxis-minor-tick-style,
    label-style: yaxis-minor-label-style,
  )

  std.place(rect(width: 100%, height: 100%, fill: gradient-atomic-density, stroke: spine-stroke))
  axes.yaxis-ticks(show-ticks: (right,), show-labels: (right,), ..colormap-minor-ticks, transform)
  axes.yaxis-ticks(show-ticks: (right,), show-labels: (right,), ..colormap-major-ticks, transform)
  draw.text(..label-colormap)
}


