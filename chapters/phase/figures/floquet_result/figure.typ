  axes.yaxis-ticks(show-ticks: (left,), show-labels: (left,), ..yaxis-major-ticks, transform)
  draw.line(..line-1)
  draw.line(..line-3)
  draw.line(..line-5)
  draw.line(..line-7)
  draw.line(..line-9)
  axes.spines(spines)
  draw.text(..label-xaxis)
  draw.text(..label-yaxis)
  draw.text(..secondary-label-yaxis)
  legend.legend(..legend-style, ..legend-items)
  axes.abc(..abc-style, 3)
}

#let axes-3(xlim: (-0.2, 10.2), ylim: (-0.05, 1.05), dpi: 100.0) = {
  let xscale = 1 / (xlim.at(1) - xlim.at(0)) * 100%
  let yscale = 1 / (ylim.at(1) - ylim.at(0)) * 100%
