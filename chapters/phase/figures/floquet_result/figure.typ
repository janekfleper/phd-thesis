  let legend-items = (
    (
      handle: legend.errorbar.with(
        data: (stroke: stroke-line-3, marker: marker-line-3),
        caps: (:),
        bars: (y: stroke-collection-4),
      ),
      label: [$-9$],
    ),
    (
      handle: legend.errorbar.with(
        data: (stroke: stroke-line-5, marker: marker-line-5),
        caps: (:),
        bars: (y: stroke-collection-6),
      ),
      label: [$-6$],
    ),
    (
      handle: legend.errorbar.with(
        data: (stroke: stroke-line-9, marker: marker-line-9),
        caps: (:),
        bars: (y: stroke-collection-10),
      ),
      label: [$-18$],
    ),
  )

  std.place(rect(width: 100%, height: 100%, fill: white, stroke: none))
  draw.collection(..collection-11)
  axes.xaxis-ticks(show-ticks: (bottom,), show-labels: (bottom,), ..xaxis-minor-ticks, transform)
  axes.yaxis-ticks(show-ticks: (left,), show-labels: (left,), ..yaxis-minor-ticks, transform)
